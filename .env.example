# --- Database ---
DATABASE_URL=postgres://slatebook:slatebook@localhost:5432/slatebook
# 통합 테스트는 이 서버에 임시 DB를 만들었다 지웁니다 (슈퍼유저 권한 필요)
TEST_DATABASE_URL=postgres://slatebook:slatebook@localhost:5432/postgres

# --- Payment gateway ---
# fake: 로컬 데모용 가짜 PG (프로덕션에서는 기동 거부)  |  toss: 토스페이먼츠  |  portone: 포트원 V2
PAYMENT_GATEWAY=fake
NEXT_PUBLIC_PAYMENT_MODE=fake
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 포트원 V2 (PAYMENT_GATEWAY=portone, NEXT_PUBLIC_PAYMENT_MODE=portone) — 관리자 콘솔의 API 시크릿·상점 ID·채널 키·웹훅 시크릿
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 접근 권한이 있는 상점이 여럿일 때만 (생략하면 API 시크릿의 상점)
PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 웹훅 URL 뒤에 붙는 공유 비밀: https://<host>/api/webhooks/pg?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# --- Auth ---
# 데모 전용 쿠키 로그인. 실서비스에서는 반드시 실제 인증(Auth.js 등)으로 교체
DEMO_AUTH=1

# --- 프로덕션 모드(next start)로 데모를 띄울 때만 ---
# 가짜 PG · 데모 인증은 프로덕션 기동을 기본적으로 거부한다 (실수로 배포되는 것을 막는 안전장치). 데모 배포라면 명시적으로 허용:
# ALLOW_FAKE_GATEWAY=1
# ALLOW_DEMO_AUTH=1

# --- 로컬 데모 ---
# 웹 서버 프로세스 안에서 만료 정리·결제 대사·정산 분개를 돌린다 (가짜 PG 데모에 필요). 실서비스에서는 0 으로 두고 `npm run worker` 를 따로 운영.
RUN_JOBS_IN_PROCESS=1
LOG_LEVEL=info
